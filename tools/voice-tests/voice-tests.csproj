<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone smoke tests for the voice pipeline (formatter, chunker, mastering).
       Deliberately NOT part of Jarvis.sln. Run manually: dotnet run (from this folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VoiceTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Jarvis.Kernel\Jarvis.Kernel.csproj" />
  </ItemGroup>
</Project>
