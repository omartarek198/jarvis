    },
    "council.future": {
      "description": "Council Future You lens — slower, reflective.",
      "engine": "kokoro", "voice": "am_adam", "speed": 0.90,
      "formatter": true, "maxSpokenChars": 420,
      "chunking": { "enabled": true, "minSplitChars": 120, "maxChunkChars": 220, "sentenceGapMs": 300, "paragraphGapMs": 600, "leadInMs": 80, "tailMs": 180 },
      "mastering": true, "cache": false, "autoEscalate": false
    },
    "council.customer": {
      "description": "Council Customer Voice lens — practical, grounded.",
      "engine": "kokoro", "voice": "af_bella", "speed": 0.97,
      "formatter": true, "maxSpokenChars": 420,
      "chunking": { "enabled": true, "minSplitChars": 160, "maxChunkChars": 220, "sentenceGapMs": 240, "paragraphGapMs": 480, "leadInMs": 60, "tailMs": 140 },
      "mastering": true, "cache": false, "autoEscalate": false
    },
    "council.sales": {
